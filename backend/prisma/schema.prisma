// Portable schema: SQLite in dev, Postgres in prod (CD5).
// JSON payloads are stored as String and (de)serialized in the service
// layer so the schema works on both connectors.
//
// 账号体系拆成两张表：
//   Teacher（老师/工号登录）与 Student（学生/学号登录），不再用 role 字段混在一张表里。
//   这样做的好处：字段各自独立（工号 vs 学号）、权限语义清晰、班级/训练/会话的归属一目了然。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 老师：用「工号」登录，创建班级、查看班级看板。
model Teacher {
  id           String      @id @default(cuid())
  employeeNo   String?     @unique // 工号（登录账号）
  email        String?     @unique // 可选补充信息
  passwordHash String
  name         String
  createdAt    DateTime    @default(now())
  classes      Classroom[] @relation("TeacherClasses")
  invites      Invite[]    @relation("AssessorInvites")
  assessed     Session[]   @relation("AssessorSessions")
}

// 学生：用「学号」登录，做模拟面试与专项训练，可加入老师的班级。
model Student {
  id           String            @id @default(cuid())
  studentNo    String?           @unique // 学号（登录账号）
  email        String?           @unique // 可选补充信息
  passwordHash String
  name         String
  createdAt    DateTime          @default(now())
  sessions     Session[]         @relation("CandidateSessions")
  drills       DrillRun[]
  memberships  ClassMembership[] @relation("StudentClasses")
}

// 班级：老师创建，学生凭加入码进班；老师在后台按班级查看学生分数。
model Classroom {
  id          String            @id @default(cuid())
  name        String
  joinCode    String            @unique
  teacherId   String
  teacher     Teacher           @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  memberships ClassMembership[]
  createdAt   DateTime          @default(now())
}

model ClassMembership {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation("StudentClasses", fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@unique([classroomId, studentId])
  @@index([studentId])
}

// 训练模块：每一项分项训练（眼神/语速/口头禅/姿态/自我介绍）的一次完成记录。
// metrics 与其余 JSON 字段一致，存 String blob，SQL 内部不查询。
model DrillRun {
  id          String   @id @default(cuid())
  userId      String // 学生 id
  user        Student  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String // gaze | pace | filler | posture | intro
  score       Int // 0-100
  durationSec Int
  metrics     String // JSON blob（该次训练的明细指标）
  createdAt   DateTime @default(now())

  @@index([userId, kind, createdAt])
}

// 历史遗留（邀请制），当前产品未使用，保留表结构避免迁移风险。
model Invite {
  id         String    @id @default(cuid())
  assessorId String
  assessor   Teacher   @relation("AssessorInvites", fields: [assessorId], references: [id])
  code       String    @unique
  email      String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

model Session {
  id            String         @id @default(cuid())
  candidateId   String // 学生 id
  candidate     Student        @relation("CandidateSessions", fields: [candidateId], references: [id])
  assessorId    String? // 历史字段，当前未使用
  assessor      Teacher?       @relation("AssessorSessions", fields: [assessorId], references: [id])
  roleField     String
  status        String         @default("created") // created | active | ended | reported
  consentAt     DateTime?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime       @default(now())
  questions     Question[]
  metricWindows MetricWindow[]
  report        Report?
  recording     Recording?
}

model Question {
  id        String    @id @default(cuid())
  sessionId String
  session   Session   @relation(fields: [sessionId], references: [id])
  order     Int
  text      String
  askedAt   DateTime?
}

model MetricWindow {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  ts        DateTime
  signals   String // JSON blob, one summary per second; never queried inside SQL

  @@index([sessionId, ts])
}

model Report {
  id         String   @id @default(cuid())
  sessionId  String   @unique
  session    Session  @relation(fields: [sessionId], references: [id])
  scores     String // JSON blob
  feedbackMd String
  transcript String
  createdAt  DateTime @default(now())
}

model Recording {
  id         String    @id @default(cuid())
  sessionId  String    @unique
  session    Session   @relation(fields: [sessionId], references: [id])
  objectKey  String
  size       Int       @default(0)
  expiresAt  DateTime
  uploadedAt DateTime?
}
